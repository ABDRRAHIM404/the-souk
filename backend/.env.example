NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/the-souk
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional: use separate secrets in production.
